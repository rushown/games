{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "animedraft": {
      "root": "src/animedraft-next",
      "framework": "nextjs"
    },
    "wheeldrafter": {
      "root": "src/wheeldrafter",
      "framework": "nextjs"
    },
    "site": {
      "root": "site"
    }
  },
  "rewrites": [
    {
      "source": "/games/animedraft(/.*)?",
      "destination": {
        "service": "animedraft"
      }
    },
    {
      "source": "/games/wheeldrafter(/.*)?",
      "destination": {
        "service": "wheeldrafter"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "site"
      }
    }
  ],
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:old(animedraft|anime){/}?",
      "destination": "/games/animedraft/",
      "permanent": true
    },
    {
      "source": "/:old(wheeldrafter|wheel){/}?",
      "destination": "/games/wheeldrafter/",
      "permanent": true
    },
    {
      "source": "/:old(momodrop|momo-drop|momo){/}?",
      "destination": "/games/momodrop/",
      "permanent": true
    },
    {
      "source": "/:old(tictactoe|tic-tac-toe|ttt){/}?",
      "destination": "/games/tictactoe/",
      "permanent": true
    },
    {
      "source": "/:old(trench|trenchdive|dive|krillion|kr){/}?",
      "destination": "/games/trench/",
      "permanent": true
    },
    {
      "source": "/:old(quizduel|quiz-duel|quiz){/}?",
      "destination": "/games/quizduel/",
      "permanent": true
    },
    {
      "source": "/animedraft.html",
      "destination": "/games/animedraft/",
      "permanent": true
    },
    {
      "source": "/momo-drop.html",
      "destination": "/games/momodrop/",
      "permanent": true
    },
    {
      "source": "/games{/}?",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
